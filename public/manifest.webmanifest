{
  "name": "Chordlab — chord detection workspace",
  "short_name": "Chordlab",
  "description": "Detect the chords in a song on your device and play along on guitar, ukulele or piano. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b0d",
  "theme_color": "#141417",
  "categories": ["music", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "audio/*": [".mp3", ".wav", ".m4a", ".ogg", ".flac"] } }
  ]
}
